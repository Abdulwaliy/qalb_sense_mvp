rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{emailId} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.source == 'landing-page';
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['interests', 'feedbackSubmittedAt'])
                    && request.resource.data.interests is list
                    && request.resource.data.interests.size() > 0;
      allow delete: if false;
      allow list: if false;
    }

    match /reflections/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /journals/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /moods/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    function isBlogAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /blogPosts/{slug} {
      allow read: if resource.data.published == true || isBlogAdmin();
      allow create, update, delete: if isBlogAdmin();
    }

    match /blogReads/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /weeklyDigests/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
